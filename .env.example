# Doorman
DOORMAN_PG_DB=doorman
DOORMAN_PG_USER=app
DOORMAN_PG_PWD=CHANGE_ME
DOORMAN_REDIS_PWD=CHANGE_ME
JWT_RSA_PRIVATE_KEY=***
DOORMAN_JWKS_URL=http://doorman/doorman/v1/.well-known/jwks.json

# Caesar
CAESAR_PG_DB=caesar
CAESAR_PG_USER=app
CAESAR_PG_PWD=CHANGE_ME

# Riddler
RIDDLER_PG_DB=riddler
RIDDLER_PG_USER=app
RIDDLER_PG_PWD=CHANGE_ME
RIDDLER_REDIS_PWD=CHANGE_ME

# Louvre
LOUVRE_PG_DB=louvre
LOUVRE_PG_USER=app
LOUVRE_PG_PWD=CHANGE_ME

# MinIO
MINIO_ROOT_USER=MINIO
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=edium-images
MINIO_USE_SSL=false

# Herald
HERALD_PG_DB=herald
HERALD_PG_USER=app
HERALD_PG_PWD=CHANGE_ME
TELEGRAM_BOT_TOKEN=***
EMAIL_API_KEY=CHANGE_ME
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM='Edium <noreply@example.com>'
SMTP_TLS_MODE=starttls
SMS_API_KEY=CHANGE_ME
# Пусто = все номера; иначе только перечисленные (E.164, как в API).
SMS_ALLOWED_PHONES=+79999999999,+79999999998
# Не слать SMS на эти номера (после проверки SMS_ALLOWED_PHONES). Тестовый из doorman по умолчанию: +70000000000
SMS_BLOCKED_PHONES=+70000000000

# Charon
CHARON_PG_DB=charon
CHARON_PG_USER=app
CHARON_PG_PWD=CHANGE_ME
CHARON_REDIS_PWD=CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# NATS
NATS_PASSWORD_DOORMAN=CHANGE_ME
NATS_PASSWORD_HERALD=CHANGE_ME
NATS_PASSWORD_CAESAR=CHANGE_ME
NATS_PASSWORD_RIDDLER=CHANGE_ME
NATS_PASSWORD_CHARON=CHANGE_ME
NATS_PASSWORD_SPHINX=CHANGE_ME

# Observability
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
