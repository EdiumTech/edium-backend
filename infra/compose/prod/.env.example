# Yandex Container Registry
YC_REGISTRY_ID=crpXXXXXXXXXXXXXX

# Image tag (задаётся при деплое)
IMAGE_TAG=latest

# Doorman — PostgreSQL (Managed)
DOORMAN_PG_USER=doorman_prod
DOORMAN_PG_PWD=CHANGE_ME
DOORMAN_PG_DB=doorman_prod
PG_HOST=rc1a-XXXXXXXXX.mdb.yandexcloud.net

# Doorman — Redis (Managed)
DOORMAN_REDIS_PWD=CHANGE_ME
REDIS_HOST=rc1a-XXXXXXXXX.rdb.yandexcloud.net

# JWT
JWT_RSA_PRIVATE_KEY=CHANGE_ME
JWT_ACTIVE_KID=key-1

# Herald — PostgreSQL (Managed)
HERALD_PG_USER=herald_prod
HERALD_PG_PWD=CHANGE_ME
HERALD_PG_DB=herald_prod

# Herald — Telegram / VK
TELEGRAM_BOT_TOKEN=CHANGE_ME
VK_GROUP_TOKEN=CHANGE_ME
VK_GROUP_ID=CHANGE_ME

# Herald — Email (SMTP + service-to-service endpoint)
EMAIL_API_KEY=CHANGE_ME
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM='Edium <noreply@example.com>'
SMTP_TLS_MODE=starttls

# Herald — SMS-шлюз (Android)
SMS_API_KEY=CHANGE_ME
# Пусто = все номера; иначе только перечисленные (E.164).
SMS_ALLOWED_PHONES=+79999999999,+79999999998
# Чёрный список (через запятую). Для «все кроме тестового»: SMS_ALLOWED_PHONES пусто, SMS_BLOCKED_PHONES=+70000000000
SMS_BLOCKED_PHONES=+70000000000

# Herald — Firebase Cloud Messaging (push-уведомления)
# Содержимое JSON-ключа сервисного аккаунта из Firebase Console → Project Settings → Service accounts
# Генерация: Generate new private key → скопировать содержимое файла в одну строку
FIREBASE_CREDENTIALS_JSON=CHANGE_ME

# Charon — PostgreSQL (Managed)
CHARON_PG_USER=charon_prod
CHARON_PG_PWD=CHANGE_ME
CHARON_PG_DB=charon_prod

# Charon — Redis (Managed, DB 1)
CHARON_REDIS_PWD=CHANGE_ME

# Riddler — Redis (Managed, логическая БД 2; отдельный пароль в ACL, как у Charon)
RIDDLER_REDIS_PWD=CHANGE_ME

# Louvre — PostgreSQL (Managed)
LOUVRE_PG_USER=louvre_prod
LOUVRE_PG_PWD=CHANGE_ME
LOUVRE_PG_DB=louvre_prod

# Louvre — S3 (локальный MinIO или Yandex Object Storage из terraform output louvre_s3_*)
LOUVRE_MINIO_ENDPOINT=storage.yandexcloud.net
LOUVRE_MINIO_ACCESS_KEY=CHANGE_ME
LOUVRE_MINIO_SECRET_KEY=CHANGE_ME
LOUVRE_MINIO_BUCKET=edium-louvre-images-prod
LOUVRE_MINIO_USE_SSL=true

# Charon — DeepSeek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# NATS — пароли сервисов (subject-level permissions в nats/nats-server.conf)
# Генерация: openssl rand -hex 32
NATS_PASSWORD_DOORMAN=CHANGE_ME
NATS_PASSWORD_HERALD=CHANGE_ME
NATS_PASSWORD_CAESAR=CHANGE_ME
NATS_PASSWORD_CHARON=CHANGE_ME
NATS_PASSWORD_RIDDLER=CHANGE_ME
NATS_PASSWORD_SPHINX=CHANGE_ME

# Sphinx (ML-аккаунт, отдельная VM на другом YC аккаунте)
# Подключается к nats-stunnel:4223 (TLS-прокси перед NATS)
# Сертификат: сгенерировать ./nats/gen-cert.sh, ca.crt — передать на Sphinx VM

# Alertmanager — Telegram
# chat_id: целое число (напр. -100xxxxxxxxxx для группы)
ALERTMANAGER_TG_TOKEN=CHANGE_ME
ALERTMANAGER_TG_CHAT_ID=CHANGE_ME

# Jaeger — basic auth (bcrypt-хеш пароля)
# Генерация: docker run --rm caddy:2-alpine caddy hash-password --plaintext <пароль>
JAEGER_BASIC_AUTH_HASH=CHANGE_ME
