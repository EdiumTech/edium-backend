openapi: 3.0.0
info:
  title: Edium Join API
  version: 1.0.0
x-yc-apigateway-cors:
  origin:
%{ for origin in allowed_origins ~}
    - ${origin}
%{ endfor ~}
  methods: [GET, POST, PATCH, DELETE, OPTIONS]
  allowedHeaders: [Content-Type, Authorization, Idempotency-Key]
  credentials: false
paths:
  /v1/uploads:
    post:
      operationId: createUpload
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '201': { description: Upload intent created }
  /v1/applications:
    post:
      operationId: createApplication
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '201': { description: Application saved }
  /v1/contest:
    get:
      operationId: getContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Authorized candidate contest }
  /v1/contest/open:
    post:
      operationId: openContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Rules opened without starting timer }
  /v1/contest/start:
    post:
      operationId: startContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Server timer started idempotently }
  /v1/contest/answers/{taskId}:
    parameters:
      - name: taskId
        in: path
        required: true
        schema: { type: string }
    patch:
      operationId: saveContestAnswer
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Answer saved with optimistic revision }
        '409': { description: A newer revision exists }
  /v1/contest/run:
    post:
      operationId: runContestTests
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Sanitized sandbox test report }
  /v1/contest/submit:
    post:
      operationId: submitContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Contest frozen idempotently }
  /v1/admin/applications:
    get:
      operationId: listApplications
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Server-authorized application list }
  /v1/admin/applications/{applicationId}:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    get:
      operationId: getApplication
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Server-authorized application details }
    patch:
      operationId: updateApplication
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Status updated }
    delete:
      operationId: deleteApplication
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Application and resume deleted }
  /v1/admin/applications/{applicationId}/resume:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    get:
      operationId: downloadResume
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: 60-second private download URL }
  /v1/admin/applications/{applicationId}/contest:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    get:
      operationId: getApplicationContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Contest and review details }
    post:
      operationId: issueApplicationContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '201': { description: Personal invitation created }
  /v1/admin/applications/{applicationId}/contest/resend:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    post:
      operationId: resendContestInvitation
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Existing invitation queued again }
  /v1/admin/applications/{applicationId}/contest/revoke:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    post:
      operationId: revokeContestInvitation
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Invitation revoked }
  /v1/admin/applications/{applicationId}/contest/extend:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    post:
      operationId: extendContestDeadline
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Deadline extended once }
  /v1/admin/applications/{applicationId}/contest/review:
    parameters:
      - name: applicationId
        in: path
        required: true
        schema: { type: string, format: uuid }
    patch:
      operationId: reviewApplicationContest
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${function_id}
        service_account_id: ${service_account_id}
      responses:
        '200': { description: Internal review saved }
